__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/
.venv/
venv/
env/
ENV/
mlruns/
.viz

# Il n'y a PAS de .env ici : le fichier est UNIQUE et vit à la racine (`../.env.dev`).
# Ces lignes sont un fil-piège — en créer un ici n'aurait aucun effet (settings.py lit
# la racine par chemin absolu), mais autant qu'un fichier égaré ne soit jamais commité.
.env
.env.*

# `package.json` n'est qu'un renvoi vers le compose du parent ; npm peut néanmoins
# déposer ceci à côté.
node_modules/
package-lock.json
conf/local/**
!conf/local/.gitkeep
conf/**/*credentials*
