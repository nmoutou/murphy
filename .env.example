# ──────────────────────────────────────────────────────────────────────────────
# Murphy — THE environment file. There is exactly one, and it is this one.
#
#     cp .env.example .env.dev        (gitignored — then fill in the secrets)
#
# It configures BOTH the Docker stack and the ingestion pipeline (`data/`).
# There is no `.env` inside `data/`; creating one has no effect, because
# `ragcore/adapters/config/settings.py` reads THIS file by absolute path.
#
# ── The one rule that explains every odd-looking line below ───────────────────
#
# The pipeline runs on the HOST (`kedro run` from a venv); the databases run in
# CONTAINERS. Host-side Mongo is `localhost:27017`; container-side it is
# `mongo:27017`. One variable cannot hold both.
#
# So: this file always speaks the HOST's language (`localhost`), because the host
# is the party that CANNOT be overridden. Compose overrides the containerised
# services with their service names, written literally in docker-compose.base.yml.
#
# Corollary — some variables you might expect are NOT here, because compose
# DERIVES them (EMBEDDING_MODEL_NAME, MONGODB_DATABASE, and the containers'
# MONGODB_URI / QDRANT_URL / EMBEDDING_SERVICE_URL). That is deliberate: a value
# that is never typed twice cannot be typed differently twice.
#
# ⚠️ NEVER put a trailing `# comment` after a value. Two different parsers read this
# file: docker-compose strips trailing comments, pydantic-settings does NOT — it takes
# the whole rest of the line as the value. `FOO=   # unused` gives pydantic the literal
# string "# unused", not "". It bit us on EMBEDDING_API_KEY, which would have gone out
# as `Authorization: Bearer # TEI needs none...`. Comments go ABOVE the line.
# ──────────────────────────────────────────────────────────────────────────────


# ── Runtime (backend) ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# ── CORS / rate limiting (backend) ────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
STREAM_RATE_LIMIT_WINDOW_MS=60000
STREAM_RATE_LIMIT_MAX=20


# ── MongoDB ───────────────────────────────────────────────────────────────────
# These credentials PROVISION the container on first boot. The URI must match.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme

# HOST-facing (the pipeline). Compose rewrites this to `mongo:27017` for the backend.
MONGODB_URI=mongodb://root:changeme@localhost:27017/?authSource=admin

# TWO databases, and the split is structural: the DATA (documents, chunks, manifest)
# live in one, the META (audit, run summaries, pending relations) in the other.
# Dropping the data must never take out the memory of what was done.
# The backend's own MONGODB_DATABASE is derived from the first one by compose.
MONGODB_DATA_DB_NAME=LEGIFRANCE
MONGODB_META_DB_NAME=MURPHY_META
MONGODB_COLLECTION=chunks
MONGODB_TIMEOUT=5000


# ── Qdrant (vector store) ─────────────────────────────────────────────────────
# HOST-facing; compose rewrites to qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ⚠️ THE PIPELINE DOES NOT WRITE HERE. This variable is read by the BACKEND only.
# The pipeline derives its collection name from a hash of the workflow config
# (normalization + chunking + embedding model — see §6 / core/config/fingerprint.py),
# e.g. `3119c73a…`, so that changing the chunk size creates a NEW collection instead
# of silently overwriting incomparable vectors.
# Consequence: the first time you run the `serve` profile, the backend will query
# `chunks`, find nothing, and return zero results WITHOUT an error. Wiring the two
# together is a real task (have the backend derive the same hash, or read the current
# collection from a Mongo meta document) — not a value to fix by hand here.
QDRANT_COLLECTION=chunks
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.0


# ── Embedding ─────────────────────────────────────────────────────────────────
# ONE model variable. It feeds TEI's `--model-id`, the backend's EMBEDDING_MODEL_NAME
# (derived by compose), and the pipeline's guard-rail. It MUST equal
# `embedding.embedding.embedding_model` in data/conf/base/parameters.yml — which is
# HASHED into the Qdrant collection name.
#
# Why the pipeline now CHECKS this instead of trusting it: TEI ignores the `model`
# field of the request and only ever serves the model it was launched with. If the two
# disagreed, you would embed with the WRONG model into the collection named after the
# RIGHT one — no error, no log, visible only at search time. `assert_service_serves_model`
# queries TEI's GET /info before the run and refuses to start on a mismatch.
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
# backend only (ms)
EMBEDDING_SERVICE_TIMEOUT=10000
# only for gated/private HF models
HUGGING_FACE_HUB_TOKEN=

# ── Embedding: the pipeline's runtime (ragcore, env_prefix `EMBEDDING_`) ──────
#   openai -> the TEI container. This is the one you want for a real run.
#   local  -> sentence-transformers, in-process (needs the model on disk).
#   noop   -> NULL VECTORS. No GPU, no network.
#
# ⚠️ `noop` is test hygiene, not a run mode: the provider is deliberately NOT part of
# the collection hash (two ways of reaching the SAME model must not fragment the
# collections), so a noop run writes null vectors INTO THE REAL MODEL'S COLLECTION,
# where nothing distinguishes them afterwards. The hook logs a loud warning.
EMBEDDING_PROVIDER=openai

# ragcore's SHAPE: an OpenAI-compatible API base, so it INCLUDES `/v1`
# (OpenAIEmbedder posts to `{base}/embeddings`). The backend wants a BARE ORIGIN
# instead — it appends `/v1/embeddings` and `/health` itself — so compose overrides
# it to `http://embedding-service:80` for that container. Same name, two shapes:
# hence the override rather than a shared value.
EMBEDDING_SERVICE_URL=http://localhost:5001/v1
EMBEDDING_BATCH_SIZE=32
# TEI needs none; empty is coerced to None
EMBEDDING_API_KEY=


# ── Neo4j ─────────────────────────────────────────────────────────────────────
# ⚠️ Two lines, one secret. NEO4J_AUTH provisions the container ("user/password");
# NEO4J_USERNAME/PASSWORD are what the pipeline's driver authenticates with. They
# MUST agree — and Neo4j persists its credentials into the volume on FIRST boot, so
# changing NEO4J_AUTH later without `docker volume rm murphy_neo4j_data` leaves the
# old password in force and yields an auth failure that explains nothing.
NEO4J_AUTH=neo4j/changeme
# HOST-facing (the pipeline)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
NEO4J_PLUGINS=["apoc"]
NEO4J_apoc_export_file_enabled=true
NEO4J_apoc_import_file_enabled=true
NEO4J_apoc_import_file_use__neo4j__config=true


# ── Pipeline (ragcore). Host-only — compose ignores every line below. ─────────
# The corpus root, ABSOLUTE: it lives in neither repo. Each source's subdirectory
# (LEGI, CASS, CAPP, CONSTIT, INCA, JADE) is a fact about the source, not config —
# it lives in sources/registry.py.
XML_SOURCE_PATH=/mnt/data/Murphy/src
META_JSONL_DIR=data/08_reporting

# Which source to ingest. Override per run: `kedro run --params source=cass`
SOURCE=legi
OWNER_ID=default


# ── LLM provider (backend; OpenAI-compatible, e.g. Mammouth.AI) ───────────────
LLM_API_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60000
# overrides the default French legal-assistant prompt
SYSTEM_PROMPT=


# ── Frontend (Next.js, public — baked into the client bundle) ─────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_WS_URL=ws://localhost:5000
