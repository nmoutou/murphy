# dev | prod — absente ou vide = prod ; toute autre valeur arrête l'ingestion
ENVIRONMENT=dev

# ==== Pipeline ====
XML_SOURCE_PATH=/data/Murphy/src
SOURCE=all
# debug | info | warning | error | critical — absente ou vide = info ; toute autre valeur arrête l'ingestion
KEDRO_LOG_LEVEL=info

# ==== Runtime (backend) ====
NODE_ENV=development
PORT=5000
NODE_LOG_LEVEL=info

# ==== CORS / rate limiting (backend) ====
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
SEARCH_RATE_LIMIT_WINDOW_MS=60000
SEARCH_RATE_LIMIT_MAX=20

# ==== MongoDB ====
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGODB_URI=mongodb://root:changeme@localhost:27017/?authSource=admin
MONGODB_DATA_DB_NAME=MURPHY_DATA
MONGODB_META_DB_NAME=MURPHY_META
MONGODB_PROBLEMS_DB_NAME=MURPHY_PROBLEMS
MONGODB_TIMEOUT=5000

# ==== OpenSearch ====
OPENSEARCH_INITIAL_ADMIN_PASSWORD=changeme
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=documents
OPENSEARCH_TIMEOUT=10000
PAGINATION_SIZES=10,25,50
PAGINATION_DEPTH=100


# ==== Embedding ====
# Lu par TEI (--model-id), le backend et l'ingestion. En changer invalide les
# vecteurs écrits : réingérer tout le corpus.
EMBEDDING_MODEL=microsoft/harrier-oss-v1-0.6b
EMBEDDING_SERVICE_TIMEOUT=10000
# Backend seul : collée telle quelle devant la question, rien devant les passages. Les
# guillemets doubles font du \n un retour à la ligne. En changer ne demande pas de
# réingestion.
EMBEDDING_QUERY_INSTRUCTION="Instruct: Retrieve text based on user query.\nQuery:"
EMBEDDING_SERVICE_URL=http://localhost:5001/v1
EMBEDDING_BATCH_SIZE=32
# Ingestion (data/), en ms : ses lots partent en parallèle, d'où plus que le backend
EMBEDDING_INGESTION_TIMEOUT=120000

# ==== Découpe (data/) ====
# Obligatoires. Liées à EMBEDDING_MODEL : en changer impose de réingérer tout le corpus.
# Valeur héritée d'all-mpnet-base-v2, sans fondement avec le modèle actuel (cf.
# docs/technical/data/reference/configuration.md).
CHUNKING_MAX_CHARS=384
# < CHUNKING_MAX_CHARS. 3 ou 4 mots, de quoi garder entier un mot coupé à la frontière.
# Non mesuré.
CHUNKING_OVERLAP_CHARS=25


# ==== Neo4j ====
NEO4J_AUTH=neo4j/changeme
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
NEO4J_PLUGINS=["apoc"]
NEO4J_apoc_export_file_enabled=true
NEO4J_apoc_import_file_enabled=true
NEO4J_apoc_import_file_use__neo4j__config=true

# ==== LLM (onglet Explications, ADR-033) ====
# Un serveur compatible OpenAI : l'URL de base, sans `/chat/completions`. Les trois
# premières sont obligatoires : sans elles, le backend refuse de démarrer.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Délai jusqu'au premier fragment de la réponse, en ms
LLM_TIMEOUT=30000
# Budget de contexte, en points de code : textes, métadonnées, prompt et conversation
LLM_CONTEXT_MAX_CHARS=100000
LLM_MAX_OUTPUT_TOKENS=2000
# Questions par IP et par fenêtre, puis appels par jour, tous clients confondus
EXPLANATION_RATE_LIMIT_WINDOW_MS=60000
EXPLANATION_RATE_LIMIT_MAX=10
EXPLANATION_DAILY_LIMIT=200

# ==== Frontend ====
NEXT_PUBLIC_API_URL=http://localhost:5000