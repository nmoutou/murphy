ENVIRONMENT=dev

# ==== Pipeline ====
XML_SOURCE_PATH=/mnt/data/Murphy/src
META_JSONL_DIR=data/08_reporting
SOURCE=all

# ==== Runtime (backend) ====
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# ==== CORS / rate limiting (backend) ====
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
STREAM_RATE_LIMIT_WINDOW_MS=60000
STREAM_RATE_LIMIT_MAX=20

# ==== MongoDB ====
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGODB_URI=mongodb://root:changeme@localhost:27017/?authSource=admin
MONGODB_DATA_DB_NAME=LEGIFRANCE
MONGODB_META_DB_NAME=MURPHY_META
MONGODB_TIMEOUT=5000

# ==== Qdrant ====
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chunks
QDRANT_TIMEOUT=10000
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.0


# ==== Embedding ====
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_SERVICE_TIMEOUT=10000
EMBEDDING_PROVIDER=openai
EMBEDDING_SERVICE_URL=http://localhost:5001/v1
EMBEDDING_BATCH_SIZE=32
# Ingestion (data/), en ms : ses lots partent en parallèle, d'où plus que le backend
EMBEDDING_INGESTION_TIMEOUT=120000
# TEI à besoin de none
EMBEDDING_API_KEY=


# ==== Neo4j ====
NEO4J_AUTH=neo4j/changeme
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
NEO4J_PLUGINS=["apoc"]
NEO4J_apoc_export_file_enabled=true
NEO4J_apoc_import_file_enabled=true
NEO4J_apoc_import_file_use__neo4j__config=true

# ==== LLM ====
LLM_API_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60000
# Override le system-prompt par defaut 
SYSTEM_PROMPT=

# ==== Frontend ====
NEXT_PUBLIC_API_URL=http://localhost:5000
