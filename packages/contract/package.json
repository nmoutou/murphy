{
  "name": "@murphy/contract",
  "version": "1.0.0",
  "private": true,
  "description": "What backend and frontend exchange at runtime: zod schemas, and the types inferred from them. One module per contract, imported by subpath (ADR-016).",
  "type": "commonjs",
  "exports": {
    "./messages": {
      "types": "./dist/messages.d.ts",
      "default": "./dist/messages.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    }
  },
  "//": "typesVersions: the same subpaths for resolvers that ignore `exports` (ts-jest forces the node10 resolution)",
  "typesVersions": {
    "*": {
      "messages": [
        "./dist/messages.d.ts"
      ],
      "errors": [
        "./dist/errors.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "ai": "^6.0.87"
  },
  "devDependencies": {
    "ai": "^6.0.87",
    "typescript": "^5.9.3"
  }
}
